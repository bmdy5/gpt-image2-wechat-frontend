/* ========================================================
   PHASE 2 ADDITIONS: ADVANCED INTERACTIONS & GLASSMORPHISMS
   ======================================================== */

/* 1. Collapsible task-card accordion */
.video-task-card {
  transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  overflow: hidden;
  max-height: 120px; /* Max height to cover open state */
  opacity: 1;
}

.video-task-card.collapsed {
  max-height: 0 !important;
  opacity: 0 !important;
  margin-top: 0 !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  border-width: 0 !important;
  pointer-events: none;
}

.rotate-90 {
  transform: rotate(90deg);
}

.icon-chevron {
  transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

/* 2. Double Confirmation Acrylic Modal */
.confirm-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(18, 18, 20, 0.4);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 150;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s cubic-bezier(0.25, 1, 0.5, 1);
}

.confirm-modal-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.confirm-modal-content {
  width: 80%;
  max-width: 320px;
  background-color: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(25px);
  -webkit-backdrop-filter: blur(25px);
  border: 0.5px solid rgba(255, 255, 255, 0.25);
  border-radius: var(--radius-2xl);
  padding: var(--spacing-lg) var(--spacing-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.12);
  transform: scale(0.92);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.confirm-modal-overlay.active .confirm-modal-content {
  transform: scale(1);
}

.confirm-modal-icon {
  margin-bottom: var(--spacing-md);
}

.confirm-modal-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--on-background);
  text-align: center;
  margin-bottom: var(--spacing-sm);
  letter-spacing: -0.2px;
}

.confirm-modal-desc {
  font-size: 13px;
  font-weight: 500;
  color: var(--on-surface-variant);
  text-align: center;
  line-height: 1.5;
  margin-bottom: var(--spacing-lg);
  padding: 0 var(--spacing-xs);
}

.confirm-modal-actions {
  width: 100%;
  display: flex;
  gap: var(--spacing-md);
}

.confirm-btn {
  flex: 1;
  height: 42px;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1);
}

.confirm-btn:active {
  transform: scale(0.95);
}

.btn-cancel {
  background-color: rgba(0, 0, 0, 0.05);
  color: var(--on-surface-variant);
  border: 0.5px solid rgba(0, 0, 0, 0.04);
}

.btn-confirm {
  background-color: var(--error);
  color: white;
  box-shadow: 0 4px 12px rgba(186, 26, 26, 0.25);
}

/* 3. High-Fidelity Gallery Detail Image Preview Overlay */
.preview-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(10, 10, 12, 0.82);
  backdrop-filter: blur(40px);
  -webkit-backdrop-filter: blur(40px);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s cubic-bezier(0.25, 1, 0.5, 1);
}

.preview-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.preview-container {
  width: 100vw;
  height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 var(--spacing-md);
}

.preview-image {
  width: 100%;
  height: 62vh;
  border-radius: var(--radius-2xl);
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
  transform: translateY(10px) scale(0.96);
  transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
}

.preview-overlay.active .preview-image {
  transform: translateY(0) scale(1);
}

/* Glassmorphism Floating Cockpit Panel */
.preview-cockpit {
  position: absolute;
  bottom: calc(50px + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%) translateY(20px);
  width: 82%;
  max-width: 320px;
  height: 64px;
  background-color: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 0.5px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-2xl);
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 var(--spacing-md);
  z-index: 210;
  opacity: 0;
  transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
}

.preview-overlay.active .preview-cockpit {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}

.preview-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  min-width: 60px;
  height: 100%;
  transition: transform 0.15s ease;
}

.preview-btn:active {
  transform: scale(0.92);
}

.icon-btn-svg {
  width: 22px;
  height: 22px;
  background-size: contain;
  background-repeat: no-repeat;
  display: block;
}

.btn-label {
  font-size: 10px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.75);
  letter-spacing: 0.5px;
}

.divider-v-cockpit {
  width: 0.5px;
  height: 24px;
  background-color: rgba(255, 255, 255, 0.15);
}

